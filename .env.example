# Optional. Without a key the game works with self-grading.
# Get a key at https://console.anthropic.com/ and paste it here, then restart `npm start`.
ANTHROPIC_API_KEY=

# Optional overrides
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=low
# PORT=4317

# No key? If Claude Code (`claude`) is installed and logged in, it grades instead.
# CLAUDE_CLI_MODEL=opus
# CLAUDE_CLI=off
